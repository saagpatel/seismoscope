// Code signing configuration (non-secret defaults).
//
// The Apple Developer Team ID is NOT committed to this repo. It lives in
// Signing.local.xcconfig (gitignored). To set up signing locally:
//
//   cp Signing.local.xcconfig.example Signing.local.xcconfig
//   # then edit Signing.local.xcconfig and set your DEVELOPMENT_TEAM
//
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = Seismoscope App Store

// Optional local override holding the Team ID (gitignored).
// Absent on CI and fresh clones — the leading '?' makes the include optional.
#include? "Signing.local.xcconfig"
